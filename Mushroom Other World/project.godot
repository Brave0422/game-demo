; Godot 4.7.2 标准版；输入与碰撞层可在编辑器审查。
config_version=5
[application]
config/name="蘑菇异界：双雄闯关"
config/description="非像素卡通横版动作冒险；单人键盘完整首关。"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[autoload]
SaveService="*res://core/save_service.gd"
GameSession="*res://core/game_session.gd"
AudioManager="*res://core/audio_manager.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
[physics]
common/physics_ticks_per_second=60
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.09,0.16,0.2,1)
[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="PlayerBody"
2d_physics/layer_3="PlayerHurtbox"
2d_physics/layer_4="EnemyHurtbox"
2d_physics/layer_5="PlayerAttack"
2d_physics/layer_6="EnemyAttack"
2d_physics/layer_7="InteractableHurtbox"
2d_physics/layer_8="Triggers"
2d_physics/layer_9="DeathZone"
[input]
move_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}
move_right={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}
move_up={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194322)]
}
move_down={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194324)]
}
shoot={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":74)]
}
jump={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":75)]
}
cycle_weapon={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":81)]
}
weapon_1={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":49)]
}
weapon_2={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":50)]
}
weapon_3={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":51)]
}
weapon_4={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":52)]
}
pause={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194305)]
}
ui_accept={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":74), Object(InputEventKey,"physical_keycode":32)]
}
